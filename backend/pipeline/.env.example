# Cloudflare credentials for R2/KV/D1 access
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id
CLOUDFLARE_R2_BUCKET=safeanot-data
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# Weekly report / FCM notification trigger
PIPELINE_SECRET=your_pipeline_secret_here
API_BASE_URL=https://your-worker.your-domain.workers.dev
